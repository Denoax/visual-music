+float wfPulse(vec2 d,float age,vec4 f,float width){
+ float q=(length(d)-34.*age)/width,base=exp(-.5*q*q);
+ if(f.x<.5||f.w<=0.)return base;
+ vec2 m=wfMetric(d,age,f);float n=m.x/width;
+ return mix(base,exp(-.5*n*n)*m.y,f.w);
+}
+`;
