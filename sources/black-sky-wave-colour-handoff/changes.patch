+ if(f.x<2.5)return vec2(u-r,exp(-.5*(v/140.)*(v/140.)));
+ if(f.x<3.5)return vec2(u+.42*(sqrt(v*v+144.)-12.)-r,exp(-.5*(v/160.)*(v/160.)));
+ if(f.x<4.5){float a=.8*u+.6*v-r,b=.8*u-.6*v-r;return vec2(abs(a)<abs(b)?a:b,exp(-.5*dot(d,d)/(240.*240.)));}
